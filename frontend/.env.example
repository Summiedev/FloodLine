# Required. The deployed FloodLine API base URL, including /api/v1.
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Public Mapbox token for browser-rendered maps only. Never use the backend secret here.
VITE_MAPBOX_ACCESS_TOKEN=pk.your_public_mapbox_token
# Optional. Shows a clearly labeled, local-only notification preview for demos.
VITE_DEMO_MODE=true
# Optional. Seconds for the controlled navigation marker/ETA simulation.
VITE_DEMO_NAVIGATION_SECONDS=1800
