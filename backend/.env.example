NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL with the PostGIS extension and a TCP-compatible Redis endpoint.
# On Vercel, use hosted services rather than the local Docker values below.
DATABASE_URL=postgresql://floodline:floodline@localhost:5432/floodline?schema=public
# Use 1 for a Vercel/serverless deployment; 5 is suitable for a local API process.
DATABASE_CONNECTION_LIMIT=5
DATABASE_TRANSACTION_MAX_WAIT_MS=15000
DATABASE_TRANSACTION_TIMEOUT_MS=15000
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=floodline

# Replace this development-only value in every deployed environment.
JWT_ACCESS_SECRET=local-development-secret-change-me-please-32
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins. Use an explicit list in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Community report association and duplicate protection
REPORT_ASSOCIATION_RADIUS_METERS=500
REPORT_ASSOCIATION_LOOKBACK_MINUTES=120
REPORT_DUPLICATE_WINDOW_SECONDS=60
REPORT_DUPLICATE_RADIUS_METERS=50

# Media uses a local/test storage provider by default. For Vercel use private,
# S3-compatible storage such as Cloudflare R2 and set all S3_* values.
MEDIA_STORAGE_PROVIDER=local
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=floodline-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MEDIA_MAX_BYTES=10000000
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_ACCESS_URL_TTL_SECONDS=900
MEDIA_MAX_ATTACHMENTS_PER_REPORT=10
MEDIA_MAX_PHOTOS_PER_INCIDENT=100

# A user may refresh a confirmation for the same incident after this cooldown.
INCIDENT_CONFIRMATION_COOLDOWN_SECONDS=900

# Transparent confidence scoring. Scores are evidence confidence, not a safety guarantee.
CONFIDENCE_RECENT_REPORT_WINDOW_HOURS=24
CONFIDENCE_RECENT_CONFIRMATION_WINDOW_HOURS=24
CONFIDENCE_STALE_AGE_HOURS=72
CONFIDENCE_MAX_CONFIRMATIONS=5
CONFIDENCE_MAX_RECENT_REPORTS=5
CONFIDENCE_MAX_RECENT_CONFIRMATIONS=5
CONFIDENCE_MAX_DISTINCT_REPORTERS=5
CONFIDENCE_MAX_PHOTOS=3
CONFIDENCE_MAX_CONTRADICTORY_REPORTS=2
CONFIDENCE_MAX_RESOLUTION_REPORTS=2
CONFIDENCE_LOW_THRESHOLD=0.5
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_OFFICIAL_MINIMUM_SCORE=0.85
CONFIDENCE_WEIGHT_CONFIRMATIONS=0.25
CONFIDENCE_WEIGHT_REPORT_RECENCY=0.15
CONFIDENCE_WEIGHT_CONFIRMATION_RECENCY=0.15
CONFIDENCE_WEIGHT_DISTINCT_REPORTERS=0.15
CONFIDENCE_WEIGHT_PHOTOS=0.1
CONFIDENCE_WEIGHT_TRUSTED_CONTRIBUTORS=0.05
CONFIDENCE_WEIGHT_OFFICIAL_SOURCE=0.15
CONFIDENCE_PENALTY_CONTRADICTORY_REPORTS=0.1
CONFIDENCE_PENALTY_RESOLUTION_REPORTS=0.2
CONFIDENCE_PENALTY_AGE=0.1

# Community incidents expire when they have no recent evidence. A confirmation extends life.
COMMUNITY_INCIDENT_STALE_AFTER_HOURS=24
COMMUNITY_CONFIRMATION_EXTENSION_HOURS=6
INCIDENT_EXPIRATION_SWEEP_INTERVAL_MS=300000

# Alert preference bounds. Radius values are stored as actual meters.
ALERT_RADIUS_MIN_METERS=500
ALERT_RADIUS_MAX_METERS=100000
ALERT_DEFAULT_RADIUS_METERS=1000

# Notification verification and alert evaluation. Set these to random values.
# If omitted, the JWT access secret is used for HMAC verification-code hashing.
NOTIFICATION_VERIFICATION_SECRET=local-notification-secret-change-me-32
NOTIFICATION_DEVICE_TOKEN_ENCRYPTION_KEY=local-device-token-encryption-secret-32
NOTIFICATION_CODE_TTL_SECONDS=600
NOTIFICATION_RESEND_COOLDOWN_SECONDS=60
NOTIFICATION_MAX_VERIFICATION_ATTEMPTS=5
ALERT_EVALUATION_BATCH_SIZE=250

# Select local adapters for development. Production options are: fcm, twilio.
PUSH_NOTIFICATION_PROVIDER=local
SMS_NOTIFICATION_PROVIDER=local
WHATSAPP_NOTIFICATION_PROVIDER=local
# Firebase server credentials: keep private and never put them in browser code.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Twilio restricted API-key credentials. WhatsApp sender includes the whatsapp: prefix.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_API_KEY_SID=SK...
# TWILIO_API_KEY_SECRET=
# TWILIO_SMS_FROM=+1234567890
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Routing and geocoding use deterministic local adapters by default. Set both
# to mapbox for live data; MAPBOX_ACCESS_TOKEN is server-only.
ROUTING_PROVIDER=local
GEOCODING_PROVIDER=local
# MAPBOX_ACCESS_TOKEN=sk...
# MAPBOX_DRIVING_PROFILE=mapbox/driving-traffic
# MAPBOX_GEOCODING_COUNTRY=ng
# MAPBOX_GEOCODING_PERMANENT=true
ROUTING_TIMEOUT_MS=8000
ROUTING_CACHE_TTL_SECONDS=60

# Route risk uses a PostGIS corridor around each candidate route. Scores are reported risk,
# not a guarantee that a route is physically safe.
ROUTE_RISK_CORRIDOR_METERS=250
ROUTE_RISK_RECENCY_WINDOW_HOURS=72
ROUTE_RISK_LOW_THRESHOLD=0.3
ROUTE_RISK_HIGH_THRESHOLD=0.7
ROUTE_RECOMMENDATION_RISK_WEIGHT=0.7
ROUTE_RECOMMENDATION_DURATION_WEIGHT=0.2
ROUTE_RECOMMENDATION_DISTANCE_WEIGHT=0.1
ROUTE_RECOMMENDATION_MAX_DURATION_OVERHEAD_RATIO=0.5
ROUTE_RECOMMENDATION_MIN_RISK_IMPROVEMENT=0.1

# Active navigation rerouting policy. Reroutes are asynchronous and cooldown-protected.
NAVIGATION_SESSION_TTL_MINUTES=120
NAVIGATION_REROUTE_COOLDOWN_SECONDS=300
NAVIGATION_MIN_RISK_IMPROVEMENT=0.1
NAVIGATION_MAX_DURATION_OVERHEAD_RATIO=0.5
NAVIGATION_EVALUATION_BATCH_SIZE=100

# Comma-separated UUIDs permitted to administer contributor status.
CONTRIBUTOR_ADMIN_USER_IDS=

GEOCODING_TIMEOUT_MS=5000
GEOCODING_CACHE_TTL_SECONDS=300
OFFICIAL_WARNING_PROVIDER_TIMEOUT_MS=10000
OFFICIAL_WARNING_MAX_FEED_ITEMS=1000

LOG_LEVEL=log
SWAGGER_ENABLED=true
METRICS_ENABLED=true
# Required in production to protect /api/v1/metrics. Use a random value of at least 32 characters.
# METRICS_ACCESS_TOKEN=

# Set false for the Vercel HTTP deployment. Run a separate persistent worker
# with this set to true; Vercel Functions are not an always-on queue worker.
JOBS_PROCESSOR_ENABLED=true
