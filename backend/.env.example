NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Local services from docker compose
DATABASE_URL=postgresql://floodline:floodline@localhost:5432/floodline?schema=public
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=floodline

# Replace this development-only value in every deployed environment.
JWT_ACCESS_SECRET=local-development-secret-change-me-please-32
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins. Use an explicit list in production.
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Community report association and duplicate protection
REPORT_ASSOCIATION_RADIUS_METERS=500
REPORT_ASSOCIATION_LOOKBACK_MINUTES=120
REPORT_DUPLICATE_WINDOW_SECONDS=60
REPORT_DUPLICATE_RADIUS_METERS=50

# Media uses a local/test storage provider by default. Add an S3-compatible
# provider adapter before selecting MEDIA_STORAGE_PROVIDER=s3.
MEDIA_STORAGE_PROVIDER=local
MEDIA_MAX_BYTES=10000000
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_ACCESS_URL_TTL_SECONDS=900

# A user may refresh a confirmation for the same incident after this cooldown.
INCIDENT_CONFIRMATION_COOLDOWN_SECONDS=900

# Transparent confidence scoring. Scores are evidence confidence, not a safety guarantee.
CONFIDENCE_RECENT_REPORT_WINDOW_HOURS=24
CONFIDENCE_RECENT_CONFIRMATION_WINDOW_HOURS=24
CONFIDENCE_STALE_AGE_HOURS=72
CONFIDENCE_MAX_CONFIRMATIONS=5
CONFIDENCE_MAX_RECENT_REPORTS=5
CONFIDENCE_MAX_RECENT_CONFIRMATIONS=5
CONFIDENCE_MAX_DISTINCT_REPORTERS=5
CONFIDENCE_MAX_PHOTOS=3
CONFIDENCE_MAX_CONTRADICTORY_REPORTS=2
CONFIDENCE_MAX_RESOLUTION_REPORTS=2
CONFIDENCE_LOW_THRESHOLD=0.5
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_OFFICIAL_MINIMUM_SCORE=0.85
CONFIDENCE_WEIGHT_CONFIRMATIONS=0.25
CONFIDENCE_WEIGHT_REPORT_RECENCY=0.15
CONFIDENCE_WEIGHT_CONFIRMATION_RECENCY=0.15
CONFIDENCE_WEIGHT_DISTINCT_REPORTERS=0.15
CONFIDENCE_WEIGHT_PHOTOS=0.1
CONFIDENCE_WEIGHT_TRUSTED_CONTRIBUTORS=0.05
CONFIDENCE_WEIGHT_OFFICIAL_SOURCE=0.15
CONFIDENCE_PENALTY_CONTRADICTORY_REPORTS=0.1
CONFIDENCE_PENALTY_RESOLUTION_REPORTS=0.2
CONFIDENCE_PENALTY_AGE=0.1

# Community incidents expire when they have no recent evidence. A confirmation extends life.
COMMUNITY_INCIDENT_STALE_AFTER_HOURS=24
COMMUNITY_CONFIRMATION_EXTENSION_HOURS=6
INCIDENT_EXPIRATION_SWEEP_INTERVAL_MS=300000

LOG_LEVEL=log
SWAGGER_ENABLED=true
