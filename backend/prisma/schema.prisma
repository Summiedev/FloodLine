generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AuthAuditAction {
  REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  TOKEN_REFRESHED
  TOKEN_REFRESH_FAILED
  LOGOUT
  PROFILE_UPDATED
}

enum IncidentType {
  SEVERE_FLOODING
  MODERATE_FLOODING
  BLOCKED_ROAD
  BLOCKED_DRAIN
}

enum IncidentSeverity {
  LOW
  MODERATE
  HIGH
  SEVERE
}

enum IncidentStatus {
  ACTIVE
  RESOLVED
  EXPIRED
  REJECTED
}

enum IncidentConfidenceLabel {
  LOW
  MEDIUM
  HIGH
}

enum IncidentSourceType {
  COMMUNITY
  OFFICIAL
}

enum FloodReportModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FloodReportWaterLevelCategory {
  NO_STANDING_WATER
  ANKLE_DEEP
  KNEE_DEEP
  VEHICLE_BONNET
  ABOVE_VEHICLE_BONNET
}

model User {
  id                   String                 @id @default(uuid()) @db.Uuid
  email                String?                @unique(map: "users_email_key") @db.VarChar(320)
  phoneNumber          String?                @unique(map: "users_phone_number_key") @map("phone_number") @db.VarChar(32)
  displayName          String                 @map("display_name") @db.VarChar(80)
  status               UserStatus             @default(ACTIVE)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  lastLoginAt          DateTime?              @map("last_login_at")
  passwordCredential   UserPasswordCredential?
  sessions             AuthSession[]
  auditLogs            AuthAuditLog[]
  floodReports         FloodReport[]

  @@index([status])
  @@index([lastLoginAt])
  @@map("users")
}

model UserPasswordCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_password_credentials")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.VarChar(64)
  createdAt        DateTime  @default(now()) @map("created_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model AuthAuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String?         @map("user_id") @db.Uuid
  action     AuthAuditAction
  identity   String?         @db.VarChar(320)
  ipAddress  String?         @map("ip_address") @db.Inet
  userAgent  String?         @map("user_agent") @db.VarChar(512)
  metadata   Json?
  createdAt  DateTime        @default(now()) @map("created_at")
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("auth_audit_logs")
}

model Incident {
  id                   String                   @id @default(uuid()) @db.Uuid
  incidentType         IncidentType             @map("incident_type")
  severity             IncidentSeverity
  status               IncidentStatus            @default(ACTIVE)
  location             Unsupported("geography(Point, 4326)")
  affectedGeometry     Unsupported("geometry(Geometry, 4326)")? @map("affected_geometry")
  locationName         String                   @map("location_name") @db.VarChar(200)
  description          String                   @db.Text
  confidenceScore      Decimal                  @map("confidence_score") @db.Decimal(4, 3)
  confidenceLabel      IncidentConfidenceLabel  @map("confidence_label")
  sourceType           IncidentSourceType       @map("source_type")
  confirmationCount    Int                      @default(0) @map("confirmation_count")
  photoCount           Int                      @default(0) @map("photo_count")
  firstReportedAt      DateTime                 @map("first_reported_at")
  lastConfirmedAt      DateTime?                @map("last_confirmed_at")
  resolvedAt           DateTime?                @map("resolved_at")
  expiresAt            DateTime?                @map("expires_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")
  floodReports         FloodReport[]

  @@index([incidentType])
  @@index([status])
  @@index([severity])
  @@index([updatedAt])
  @@map("incidents")
}

model FloodReport {
  id                 String                        @id @default(uuid()) @db.Uuid
  reporterUserId     String                        @map("reporter_user_id") @db.Uuid
  incidentId         String                        @map("incident_id") @db.Uuid
  reportType         IncidentType                  @map("report_type")
  location           Unsupported("geography(Point, 4326)")
  locationName       String                        @map("location_name") @db.VarChar(200)
  description        String                        @db.Text
  observedSeverity   IncidentSeverity              @map("observed_severity")
  waterLevelCategory FloodReportWaterLevelCategory? @map("water_level_category")
  occurredAt         DateTime                      @default(now()) @map("occurred_at")
  createdAt          DateTime                      @default(now()) @map("created_at")
  moderationStatus   FloodReportModerationStatus   @default(PENDING) @map("moderation_status")
  sourceMetadata     Json?                         @map("source_metadata")
  reporter           User                          @relation(fields: [reporterUserId], references: [id], onDelete: Restrict)
  incident           Incident                      @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  @@index([reporterUserId, createdAt])
  @@index([incidentId, createdAt])
  @@index([reportType, createdAt])
  @@index([moderationStatus, createdAt])
  @@map("flood_reports")
}
